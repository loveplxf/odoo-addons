<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mrp_oee_productivity_list" model="ir.ui.view">
            <field name="name">mrp.oee.productivity.list</field>
            <field name="model">mrp.oee.productivity</field>
            <field name="arch" type="xml">
                <list string="Downtime Records">
                    <field name="date"/>
                    <field name="shift_id"/>
                    <field name="workcenter_id"/>
                    <field name="hour_from" widget="float_time"/>
                    <field name="hour_to" widget="float_time"/>
                    <field name="duration" widget="float_time"/>
                    <field name="loss_reason_id"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_mrp_oee_productivity_form" model="ir.ui.view">
            <field name="name">mrp.oee.productivity.form</field>
            <field name="model">mrp.oee.productivity</field>
            <field name="arch" type="xml">
                <form string="Downtime Record">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="shift_id"/>
                                <field name="workcenter_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="loss_reason_id"/>
                                <field name="hour_from" widget="float_time"/>
                                <field name="hour_to" widget="float_time"/>
                                <field name="duration" widget="float_time"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_mrp_oee_productivity_search" model="ir.ui.view">
            <field name="name">mrp.oee.productivity.search</field>
            <field name="model">mrp.oee.productivity</field>
            <field name="arch" type="xml">
                <search string="Downtime Records">
                    <field name="workcenter_id"/>
                    <field name="shift_id"/>
                    <field name="loss_reason_id"/>
                    <field name="date"/>
                    <filter name="filter_date" string="Date" date="date"/>
                    <group>
                        <filter name="group_workcenter" string="Work Center" context="{'group_by': 'workcenter_id'}"/>
                        <filter name="group_shift" string="Shift" context="{'group_by': 'shift_id'}"/>
                        <filter name="group_reason" string="Downtime Reason" context="{'group_by': 'loss_reason_id'}"/>
                        <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_mrp_oee_productivity" model="ir.actions.act_window">
            <field name="name">Downtime Records</field>
            <field name="res_model">mrp.oee.productivity</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_mrp_oee_productivity_search"/>
        </record>
    </data>
</odoo>
