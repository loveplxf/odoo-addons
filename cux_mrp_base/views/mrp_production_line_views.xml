<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action -->
        <record id="action_mrp_production_line" model="ir.actions.act_window">
            <field name="name">Production Lines</field>
            <field name="res_model">mrp.production.line</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'active_test': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No production lines yet!
                </p>
                <p>
                    Click to create your first production line, supporting a
                    Factory → Shop Floor → Production Line hierarchy.
                </p>
            </field>
        </record>

        <!-- List View (Tree) -->
        <record id="view_mrp_production_line_tree" model="ir.ui.view">
            <field name="name">mrp.production.line.list</field>
            <field name="model">mrp.production.line</field>
            <field name="arch" type="xml">
                <list string="Production Lines" decoration-info="type=='factory'" decoration-success="type=='shop_floor'" decoration-warning="type=='production_line'">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="type"/>
                    <field name="complete_name"/>
                    <field name="parent_id"/>
                    <field name="child_count"/>
                    <field name="workcenter_count"/>
                    <field name="company_id" column_invisible="True"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_mrp_production_line_form" model="ir.ui.view">
            <field name="name">mrp.production.line.form</field>
            <field name="model">mrp.production.line</field>
            <field name="arch" type="xml">
                <form string="Production Line">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_children"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="list_alt"
                                    invisible="child_count == 0">
                                <field name="child_count" widget="statinfo" string="Children"/>
                            </button>
                            <button name="action_view_workcenters"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="business"
                                    invisible="workcenter_count == 0">
                                <field name="workcenter_count" widget="statinfo" string="Work Centers"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="type"/>
                                <field name="parent_id"
                                       invisible="type == 'factory'"
                                       readonly="type == 'factory'"
                                       placeholder="None (Top Level)"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="complete_name" readonly="1"/>
                                <field name="child_count"/>
                                <field name="workcenter_count"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes" name="description">
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="Children" name="children">
                                <field name="child_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="type"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_mrp_production_line_search" model="ir.ui.view">
            <field name="name">mrp.production.line.search</field>
            <field name="model">mrp.production.line</field>
            <field name="arch" type="xml">
                <search string="Production Lines">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="complete_name"/>
                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_mrp_production_line_kanban" model="ir.ui.view">
            <field name="name">mrp.production.line.kanban</field>
            <field name="model">mrp.production.line</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="type"/>
                    <field name="complete_name"/>
                    <field name="child_count"/>
                    <field name="workcenter_count"/>
                    <templates>
                        <t t-name="card">
                            <field name="type" widget="badge"/>
                            <div class="oe_kanban_global_click o_kanban_record">
                                <h3>
                                    <field name="name"/>
                                </h3>
                                <div class="text-muted" t-if="record.code.raw_value">
                                    <field name="code"/>
                                </div>
                                <div class="mt8">
                                    <span class="badge rounded-pill text-bg-secondary" t-if="record.child_count.raw_value">
                                        Children: <field name="child_count"/>
                                    </span>
                                    <span class="badge rounded-pill text-bg-info" t-if="record.workcenter_count.raw_value">
                                        Work Centers: <field name="workcenter_count"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>
