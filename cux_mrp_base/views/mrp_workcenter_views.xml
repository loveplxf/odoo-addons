<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 在 mrp.workcenter 的列表视图增加生产线字段 -->
        <record id="view_mrp_workcenter_list_inherit_production_line" model="ir.ui.view">
            <field name="name">mrp.workcenter.list.inherit.production.line</field>
            <field name="model">mrp.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_workcenter_tree_view"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="production_line_id" optional="show"/>
                    <field name="team_ids" widget="many2many_tags" optional="hide"/>
                    <field name="shift_ids" widget="many2many_tags" optional="hide"/>
                    <field name="shop_floor_id" optional="hide"/>
                    <field name="factory_id" optional="hide"/>
                </field>
            </field>
        </record>

        <!-- 在 mrp.workcenter 的表单视图增加生产线字段 -->
        <record id="view_mrp_workcenter_form_inherit_production_line" model="ir.ui.view">
            <field name="name">mrp.workcenter.form.inherit.production.line</field>
            <field name="model">mrp.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
            <field name="arch" type="xml">
                <field name="code" position="after">
                    <field name="production_line_id"/>
                    <field name="team_ids" widget="many2many_tags"/>
                    <field name="shift_ids" widget="many2many_tags"/>
                </field>
            </field>
        </record>

        <!-- 在 mrp.workcenter 的搜索视图增加 searchpanel（工厂 / 车间 / 产线） -->
        <record id="view_mrp_workcenter_search_inherit_production_line" model="ir.ui.view">
            <field name="name">mrp.workcenter.search.inherit.production.line</field>
            <field name="model">mrp.workcenter</field>
            <field name="inherit_id" ref="mrp.view_mrp_workcenter_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <searchpanel>
                        <field name="production_line_id" string="Production Line" icon="factory" enable_counters="1" depth="3"/>
                    </searchpanel>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
