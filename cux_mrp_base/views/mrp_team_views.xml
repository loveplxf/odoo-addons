<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action -->
        <record id="action_mrp_team" model="ir.actions.act_window">
            <field name="name">Teams</field>
            <field name="res_model">mrp.team</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'active_test': False}</field>
        </record>

        <!-- List View (Tree) -->
        <record id="view_mrp_team_tree" model="ir.ui.view">
            <field name="name">mrp.team.list</field>
            <field name="model">mrp.team</field>
            <field name="arch" type="xml">
                <list string="Teams">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="leader_id"/>
                    <field name="member_ids" widget="many2many_tags"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="company_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_mrp_team_form" model="ir.ui.view">
            <field name="name">mrp.team.form</field>
            <field name="model">mrp.team</field>
            <field name="arch" type="xml">
                <form string="Teams">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="leader_id"/>
                                <field name="active"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Team Members" name="members">
                                <field name="member_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="job_title"/>
                                        <field name="department_id"/>
                                        <field name="work_email"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_mrp_team_search" model="ir.ui.view">
            <field name="name">mrp.team.search</field>
            <field name="model">mrp.team</field>
            <field name="arch" type="xml">
                <search string="Teams">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="leader_id"/>
                    <field name="member_ids"/>
                </search>
            </field>
        </record>

    </data>
</odoo>
