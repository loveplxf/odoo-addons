<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action -->
        <record id="action_mrp_shift" model="ir.actions.act_window">
            <field name="name">Shifts</field>
            <field name="res_model">mrp.shift</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- List View (Tree) -->
        <record id="view_mrp_shift_tree" model="ir.ui.view">
            <field name="name">mrp.shift.list</field>
            <field name="model">mrp.shift</field>
            <field name="arch" type="xml">
                <list string="Shifts">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="company_id" column_invisible="True"/>
                    <field name="hour_from" widget="float_time"/>
                    <field name="hour_to" widget="float_time"/>
                    <field name="work_hours"/>
                    <field name="break_hours"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_mrp_shift_form" model="ir.ui.view">
            <field name="name">mrp.shift.form</field>
            <field name="model">mrp.shift</field>
            <field name="arch" type="xml">
                <form string="Shift">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="hour_from" widget="float_time"/>
                                <field name="hour_to" widget="float_time"/>
                            </group>
                            <group>
                                <field name="work_hours"/>
                                <field name="break_hours"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <field name="worktime_ids">
                            <list editable="bottom">
                                <field name="next_day"/>
                                <field name="name"/>
                                <field name="day_period"/>
                                <field name="hour_from" widget="float_time"/>
                                <field name="hour_to" widget="float_time"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_mrp_shift_search" model="ir.ui.view">
            <field name="name">mrp.shift.search</field>
            <field name="model">mrp.shift</field>
            <field name="arch" type="xml">
                <search string="Shifts">
                    <field name="name"/>
                    <field name="company_id"/>
                </search>
            </field>
        </record>

    </data>
</odoo>
